# --- Data & weights: NEVER in git (GOAL.md Article 8) ---
# Path-based, not extension-based (session-0003, generalizing the session-0002 P0-1 fix):
# a file is data because of WHERE it lives, not what it is called. Ignoring by
# extension silently drops source files from a fresh clone — the exact failure
# that made v1 "green locally, red on a clone".
data/**
!data/.gitkeep
!data/manifests/
!data/manifests/**

# Weights and binary artifacts are never source, wherever they live.
*.bin
*.nnue
*.pt
*.pth
*.safetensors
*.ckpt
*.part
*.zst

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
